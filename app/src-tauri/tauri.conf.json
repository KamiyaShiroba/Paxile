{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paxile",
  "version": "0.1.0",
  "identifier": "com.paxile.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build && cargo build --manifest-path ../Cargo.toml --workspace --locked --target-dir ../target/reconnect"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBODFGNURCRUYzMEFGOUMKUldTY3J6RHYyL1dCS282Z21oR1cwSVJaVzRZUlNVNnVmZ0JiZUIzcUg5bExRVUYvdE91djdmK3YK",
      "endpoints": ["https://github.com/KamiyaShiroba/Paxile/releases/latest/download/latest.json"],
      "windows": { "installMode": "quiet" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../target/reconnect/debug/paxile-probe.exe": "paxile-probe.exe",
      "../../target/reconnect/debug/paxile_spy.dll": "paxile_spy.dll"
    },
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
