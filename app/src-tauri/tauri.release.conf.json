{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build && cargo build --manifest-path ../Cargo.toml --workspace --locked --release --target-dir ../target/reconnect"
  },
  "bundle": {
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../../target/reconnect/debug/paxile-probe.exe": null,
      "../../target/reconnect/debug/paxile_spy.dll": null,
      "../../target/reconnect/release/paxile-probe.exe": "paxile-probe.exe",
      "../../target/reconnect/release/paxile_spy.dll": "paxile_spy.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "../../scripts/installer-hooks.nsh"
      }
    }
  }
}
